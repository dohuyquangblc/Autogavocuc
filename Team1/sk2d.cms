#name("sk2d") 
#autorun    
#includer("sub.xml") 

team(1,1,2)


moiban()


batdau2("aim30_2 ")



chonpb(3,2,1,1)


latthe(1,10)



if_pixel_in(234,37,234,37,255) 
logwrite("bat auto")
LCLICK(243,8)  // 13941150 // bat auto dame
waitms(500)
end_if 

if_pixel_in(478,265,478,265,1856766) 
logwrite("gom buff")
LCLICK(470,233) // thu buff
waitms(500)
end_if 

Getscreen 

// Kiểm tra màu A
if_pixel_in(176,145,176,145,16121340) // turn cho den luot
   LOGWRITE("buffdame")
   WAITMS(500)
   #include "ht\buff.txt"

   WAITMS(2500) 
   // -> Đã trôi qua khoảng 3 giây kể từ khi thấy màu A

   // Kiểm tra màu B
   IF_PIXEL_IN(290, 40, 290, 40, 3092050)
      FOR($i=0, $i < 6)
         KEYPRESS(#Q)
         WAITMS(50)
      END_CYC
   END_IF

   // Chờ thêm 2 giây nữa cho đủ mốc 6 giây
   WAITMS(2000)
   // Sau 2 giây, nếu điểm đó VẪN CÒN màu A thì ấn P dự phòng
      KEYPRESS(#P)
      LOGWRITE("Da an P du phong")


END_IF


	   