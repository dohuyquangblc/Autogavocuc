#name("sk2d") 
#autorun    
#includer("sub.xml") 

team(1,1,2)


moiban()


batdau2("aim30_1 ")



chonpb(3,2,1,1)


latthe(1,10)



if_pixel_in(234,37,234,37,255) 
logwrite("bat auto")
LCLICK(243,8)  // 13941150 // bat auto dame
waitms(500)
end_if 

if_pixel_in(478,265,478,265,1856766) 
logwrite("gom buff")
LCLICK(470,233) // thu buff
waitms(500)
end_if 

Getscreen 

// Kiểm tra màu A
IF_PIXEL_IN(239, 114, 239, 114, 16121087)
   LOGWRITE("buffdame")
   WAITMS(500)
   #include "ht\buff.txt"

   WAITMS(2500) 
   // -> Đã trôi qua khoảng 3 giây kể từ khi thấy màu A

   // Kiểm tra màu B
   IF_PIXEL_IN(290, 40, 290, 40, 3092050)
      FOR($i=0, $i < 6)
         KEYPRESS(#Q)
         WAITMS(50)
      END_CYC
   END_IF

   // Chờ thêm 3 giây nữa cho đủ mốc 6 giây
   WAITMS(3000)

   // Sau 6 giây, nếu điểm đó VẪN CÒN màu A thì ấn P dự phòng
   IF_PIXEL_IN(239, 114, 239, 114, 16121087)
      KEYPRESS(#P)
      WAITMS(50)
      LOGWRITE("Da an P du phong")
   END_IF

   // Chờ nốt 15 giây còn lại (tổng thời gian chờ vẫn là 18s như cũ)
   WAITMS(15000)
END_IF


	   